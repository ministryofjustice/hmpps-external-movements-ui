{% extends "partials/layout.njk" %}
{% from "dps/components/address-autosuggest/macro.njk" import addressAutosuggest %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/select/macro.njk" import govukSelect %}

{% set fullWidth = true %}
{% set pageTitle = 'Search for a location - Add a temporary absence' %}

{% block meta %}
  <meta name="autocompleteElements" content="location"/>
{% endblock %}

{% block innerContent %}
  <div class="govuk-width-container">
    <span class="govuk-caption-l">Create a Temporary Absence</span>
    <h1 class="govuk-heading-l">Add a location for this absence</h1>

    <p>You can add multiple locations if this absence will happen in multiple places.</p>
    <p>Enter a location manually if it:</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>does not appear in the search results</li>
      <li>is not a specific address but a whole area (for example, York)</li>
    </ul>

    <h2 class="govuk-heading-m">Select or add a location</h2>

    {% if locationOptions.length %}
      {% set selectSavedLocationHtml %}
        <div class="govuk-grid-row">
          <div class="govuk-grid-column-two-thirds">
            <form method="post" action="search-locations/selected-location">
              <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
              <h3 class="govuk-heading-m">You have {{ locationOptions.length }} saved location{{ 's' if locationOptions.length !== 1 else '' }}</h3>
              {{ govukSelect({
                label: {
                  text: "Search saved locations"
                },
                id: "location",
                name: "location",
                items: locationOptions | prependEmptyOption,
                errorMessage: validationErrors | findError('location')
              }) }}

              {{ govukButton({
                classes: "govuk-button--secondary",
                text: "Add location",
                preventDoubleClick: true
              }) }}
            </form>
          </div>
        </div>
      {% endset %}
    {% endif %}

    {% set searchAddressesHtml %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <form method="post" action="search-locations/searched-address">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            <h3 class="govuk-visually-hidden"><label for="address-autosuggest-input">Search and add a UK address</label></h3>
            <div id="address-hint" class="govuk-body">Enter an address or postcode</div>
            <div id="address-input">
              {{ addressAutosuggest({
                classes: 'govuk-!-margin-bottom-5',
                inputValue: inputValue,
                uprn: uprn,
                errorMessage: validationErrors | findError('address-autosuggest-input'),
                findUrl: '/api/addresses/find'
              }) }}
            </div>
            {{ govukButton({
              classes: "govuk-button--secondary",
              text: "Add location",
              preventDoubleClick: true
            }) }}
          </form>
        </div>
      </div>
    {% endset %}

    {% set enterAddressHtml %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <form method="post" action="search-locations/entered-address">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            {{ govukInput({
              id: "description",
              name: "description",
              label: { text: "Business or organisation name (optional)" },
              classes: 'govuk-!-width-two-thirds',
              errorMessage: validationErrors | findError('description'),
              value: description,
              attributes: { autocomplete: "organization" }
            }) }}
            {{ govukInput({
              id: "line1",
              name: "line1",
              label: { text: "Address line 1 (optional)" },
              classes: 'govuk-!-width-two-thirds',
              errorMessage: validationErrors | findError('line1'),
              value: line1,
              attributes: { autocomplete: "address-line1" }
            }) }}
            {{ govukInput({
              id: "line2",
              name: "line2",
              label: { text: "Address line 2 (optional)" },
              classes: 'govuk-!-width-two-thirds',
              errorMessage: validationErrors | findError('line2'),
              value: line2,
              attributes: { autocomplete: "address-line2" }
            }) }}
            {{ govukInput({
              id: "city",
              name: "city",
              label: { text: "Town or city" },
              classes: 'govuk-!-width-one-half',
              errorMessage: validationErrors | findError('city'),
              value: city,
              attributes: { autocomplete: "address-level2" }
            }) }}
            {{ govukInput({
              id: "county",
              name: "county",
              label: { text: "County (optional)" },
              classes: 'govuk-!-width-one-half',
              errorMessage: validationErrors | findError('county'),
              value: county,
              attributes: { autocomplete: "address-level1" }
            }) }}
            {{ govukInput({
              id: "postcode",
              name: "postcode",
              label: { text: "Postcode (optional)" },
              classes: 'govuk-!-width-one-third',
              errorMessage: validationErrors | findError('postcode'),
              value: postcode,
              attributes: { autocomplete: "postal-code" }
            }) }}
            {{ govukButton({
              classes: "govuk-button--secondary",
              text: "Add location",
              preventDoubleClick: true
            }) }}
          </form>
        </div>
      </div>
    {% endset %}

    {% set enterAreaHtml %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <form method="post" action="search-locations/area">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
            {{ govukInput({
              id: "area",
              name: "area",
              label: { text: "Area description" },
              hint: { text: "Eg, York city centre" },
              errorMessage: validationErrors | findError('area'),
              value: area
            }) }}
            {{ govukButton({
              classes: "govuk-button--secondary",
              text: "Add location",
              preventDoubleClick: true
            }) }}
          </form>
        </div>
      </div>
    {% endset %}

    {{ govukTabs({
      items: [
        {
          label: "Search all UK addresses",
          id: "search-address",
          panel: { html: searchAddressesHtml }
        },
        {
          label: "Select a saved location",
          id: "select-location",
          panel: { html: selectSavedLocationHtml }
        } if locationOptions.length,
        {
          label: "Enter an address",
          id: "enter-address",
          panel: { html: enterAddressHtml }
        },
        {
          label: "Enter an area",
          id: "enter-area",
          panel: { html: enterAreaHtml }
        }
      ] | removeNullish
    }) }}

    {% if locations.length %}
      <form method="post" class="govuk-!-width-full">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
        <h2 class="govuk-heading-m">You have added {{ locations.length }} {{ "location" if locations.length === 1 else "locations" }}</h2>

        <div class="govuk-!-margin-bottom-6">
          {% for location in locations %}
            <div class="govuk-grid-row">
              <div class="govuk-grid-column-three-quarters">{{ location | joinAddress }}</div>
              <div class="govuk-summary-card__actions"><a href="search-locations/remove/{{ loop.index }}" class="govuk-link govuk-link--no-visited-state">Remove<span class="govuk-visually-hidden"> location {{ loop.index }}</span></a></div>
            </div>
          {% endfor %}
        </div>

        {{ govukButton({
          name: "save",
          text: "Continue",
          preventDoubleClick: true
        }) }}
      </form>
    {% endif %}
  </div>
{% endblock %}

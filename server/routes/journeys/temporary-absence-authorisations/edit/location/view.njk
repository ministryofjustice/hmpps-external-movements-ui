{% extends "partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set mainClasses = "app-container govuk-body" %}

{% set fullWidth = true %}
{% set pageTitle = 'Add a location for this absence - Manage temporary absences' %}

{% block innerContent %}
  <div class="govuk-width-container">
    <span class="govuk-caption-l">Manage Temporary Absences</span>
    <h1 class="govuk-heading-l">Add a location for this absence</h1>

    <p>Enter a location manually if it:</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>does not appear in the search results</li>
      <li>is not a specific address but a whole area (for example, York)</li>
    </ul>

    {% set postUrl = 'location' %}
    {% set locationButton %}
      {{ govukButton({
        text: "Continue",
        preventDoubleClick: true
      }) }}
    {% endset %}
    {% include 'partials/selectLocationTab.njk' %}
  </div>
{% endblock %}
